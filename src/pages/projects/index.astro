---
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedProjects } from "@/utils/content-utils";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import {
	getProjectStatusMeta,
	PROJECT_STATUS_KEYS,
	resolveProjectImage,
} from "@/utils/projects-utils";
import { removeFileExtension, url } from "@/utils/url-utils";
import "@/styles/pages/sw-projects.css";

// 检查页面是否启用
if (!siteConfig.pages.projects) {
	return Astro.redirect("/404/");
}

const title = i18n(I18nKey.projects);
const description = i18n(I18nKey.projectsDescription);

const projects = await getSortedProjects();
const cards = await Promise.all(
	projects.map(async (p) => ({
		slug: removeFileExtension(p.id),
		title: p.data.title,
		description: p.data.description,
		image: await resolveProjectImage(p.data.image, p.filePath),
		tags: p.data.tags,
		published: p.data.published,
		status: p.data.status,
		statusLabel: getProjectStatusMeta(p.data.status).label,
		links: p.data.link,
	})),
);

// 状态筛选按钮
const statusFilters = PROJECT_STATUS_KEYS.map((key) => {
	const meta = getProjectStatusMeta(key);
	return { key, label: meta.label, icon: meta.icon };
});
---

<MainGridLayout title={title} description={description}>
	<div class="sw-projects">
		<header class="sw-header">
			<div>
				<h1>{title}</h1>
				{description && <p>{description}</p>}
			</div>
			<div class="sw-count">
				<strong>{cards.length}</strong> 个项目
			</div>
		</header>

		<project-filter class="sw-toolbar">
			<input
				type="text"
				data-search
				placeholder={i18n(I18nKey.projectSearch)}
				aria-label={i18n(I18nKey.projectSearch)}
				class="sw-search"
			/>
			<button data-status="all" class="sw-pill" data-active>
				{i18n(I18nKey.all)}
			</button>
			{
				statusFilters.map((s) => (
					<button data-status={s.key} class="sw-pill">
						{s.icon && <Icon name={s.icon} class="text-base" />}
						{s.label}
					</button>
				))
			}
		</project-filter>

		{
			cards.length > 0 ? (
				<div class="sw-grid">
					{cards.map((p) => (
						<article
							class="sw-card project-card"
							data-status={p.status}
							data-tags={p.tags.join(",")}
						>
							<div class="sw-cover">
								{p.image ? (
									<img src={p.image} alt={p.title} loading="lazy" decoding="async" />
								) : (
									<span aria-hidden="true">{p.title.charAt(0)}</span>
								)}
							</div>
							<h3 class="sw-title">{p.title}</h3>
							{p.description && <p class="sw-desc">{p.description}</p>}
							<div class="sw-meta">
								<time datetime={p.published.toISOString()}>
									{formatDateToYYYYMMDD(p.published)}
								</time>
								{p.statusLabel && <span class="sw-status">{p.statusLabel}</span>}
							</div>
							{p.tags.length > 0 && (
								<div class="sw-tags">
									{p.tags.map((t) => (
										<span class="sw-tag">{t}</span>
									))}
								</div>
							)}
							{p.links.length > 0 && (
								<div class="sw-links">
									{p.links.map((l) => (
										<a href={l.value} target="_blank" rel="noopener noreferrer">
											{l.label}
										</a>
									))}
								</div>
							)}
							<a class="sw-stretched" href={url(`/projects/${p.slug}/`)} aria-label={p.title} />
						</article>
					))}
				</div>
			) : (
				<div class="sw-empty">
					<Icon name="material-symbols:rocket-launch" class="text-5xl" />
					<p>{i18n(I18nKey.projectEmpty)}</p>
				</div>
			)
		}

		<div class="sw-empty projects-empty hidden">
			<Icon name="material-symbols:search-off-rounded" class="text-4xl" />
			<div>{i18n(I18nKey.searchNoResults)}</div>
		</div>
	</div>

	<script slot="head" is:inline>
		if (!customElements.get("project-filter")) {
			class ProjectFilter extends HTMLElement {
				selectedStatus = "all";
				connectedCallback() {
					this.addEventListener("click", this.handleClick);
					this.addEventListener("input", this.handleInput);
				}
				disconnectedCallback() {
					this.removeEventListener("click", this.handleClick);
					this.removeEventListener("input", this.handleInput);
				}
				handleClick(e) {
					const button = e.target.closest("button");
					if (!button) return;
					this.selectedStatus = button.dataset.status;
					this.querySelectorAll("button").forEach((b) =>
						b.removeAttribute("data-active"),
					);
					button.setAttribute("data-active", "");
					this.applyFilters();
				}
				handleInput() {
					this.applyFilters();
				}
				applyFilters() {
					const container = this.closest(".sw-projects");
					if (!container) return;
					const query = (this.querySelector("[data-search]")?.value || "")
						.toLowerCase()
						.trim();
					const cards = container.querySelectorAll(".project-card");
					let hasVisible = false;
					cards.forEach((card) => {
						const statusMatch =
							this.selectedStatus === "all" ||
							card.dataset.status === this.selectedStatus;
						const haystack = (
							(card.querySelector(".sw-title")?.textContent || "") +
							" " +
							(card.querySelector(".sw-desc")?.textContent || "") +
							" " +
							(card.dataset.tags || "")
						).toLowerCase();
						const searchMatch = !query || haystack.includes(query);
						const visible = statusMatch && searchMatch;
						card.style.display = visible ? "" : "none";
						if (visible) hasVisible = true;
					});
					const empty = container.querySelector(".projects-empty");
					if (empty) empty.classList.toggle("hidden", hasVisible);
				}
			}
			customElements.define("project-filter", ProjectFilter);
		}
	</script>
</MainGridLayout>
